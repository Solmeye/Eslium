{
  "schema_version": 1,
	"quilt_loader": {
	  "group": "${group}",
		"id": "${id}",
		"version": "${version}",
		"depends": [
  		{
  			"id": "quilt_loader",
  			"versions": ">=0.19.1"
  		},
  		{
  			"id": "minecraft",
  			"versions": "${minecraft_range}"
  		}
		],
		"intermediate_mappings": "net.fabricmc:intermediary",
		"metadata": {
			"name": "${name}",
			"description": "${description}",
			"contributors": {
				"${authors}": "Owner"
			},
			"contact": {
				"homepage": "https://example.com/",
				"issues": "https://github.com/QuiltMC/quilt-template-mod/issues",
				"sources": "https://github.com/QuiltMC/quilt-template-mod"
			},
			"license": "${license}",
			"icon": "assets/example_mod/icon.png"
		}
	},
	"mixin": "${id}.mixins.json",
  "accessWidener": "${id}.accesswidener"
}
