{
  "schema_version": 1,
	"quilt_loader": {
	  "group": "${group}",
		"id": "${id}",
		"version": "${version}",
		"depends": [
  		{
  			"id": "quilt_loader",
  			"versions": ">=0.19.1"
  		},
  		{
  			"id": "minecraft",
  			"versions": "${constraint_minecraft}"
  		}
		],
		"intermediate_mappings": "net.fabricmc:intermediary",
		"metadata": {
			"name": "${name}",
			"description": "${description}",
			"contributors": {
				"${author}": "Owner"
			},
			"contact": {
				"homepage": "${homepage}",
				"sources": "${sources}",
				"issues": "${issues}",
				"discord": "${discord}"
			},
			"license": "${license}",
			"icon": "assets/example_mod/icon.png"
		}
	},
	"mixin": "${id}.mixins.json",
  "accessWidener": "${id}.accesswidener"
}
