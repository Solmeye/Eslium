  "authors": ["${author}"],
  "contact": {
    "homepage": "${homepage}",
		"sources": "${sources}",
		"issues": "${issues}",
		"discord": "${discord}"
	},
  "license": "${license}",
  "icon": "${icon}",
  "environment": "client",
  "entrypoints": {},
